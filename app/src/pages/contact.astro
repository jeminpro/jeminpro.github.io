---
import Layout from "../layouts/BaseLayout.astro";

---

<Layout title="Contact" isMainLarge={false}>
	<div class="contact-page">
		<h2>Hey, hi, and hello!</h1>
		
		<p>I love hearing from readers! You can use this form to reach out to me with any questions, comments, or concerns.</p>

		<iframe data-tally-src="https://tally.so/embed/ja5GBQ?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&formEventsForwarding=1" loading="lazy" width="100%" height="342" frameborder="0" marginheight="0" marginwidth="0" title="Send a message"></iframe>
		
	</div>
</Layout>

<style>
	.intro {
		background: #ece7e7;
		padding: 2rem;
		margin-top: 1rem;
		border-radius: 10px;

	}

	.intro h1 {
		margin: 0 0 1rem;
	}

	.title-introduction {
		margin-bottom: 2rem;
	}

	.load-more {
		text-align: center;
		padding: 1em 0;
	}

	a.load-more__link {
		letter-spacing: 1px;
		background-position: center 72%;
		text-transform: uppercase;
		font-size: 0.75em;
		color: inherit;
		background: 0 0;
		text-shadow: none;
		border-bottom: 5px solid #d33a2c;
		letter-spacing: 1px;
		transition: all 0.1s ease-out;
		display: inline-block;
		cursor: pointer;
		text-decoration: none;
	}

	a.load-more__link:focus,
	a.load-more__link:hover {
		color: #d33a2c;
	}
</style>

<script is:inline>//@ts-nocheck
	var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
</script>