---
import Layout from "../layouts/BaseLayout.astro";

---

<Layout title="Contact" isMainLarge={false}>
	<div class="contact-page">
		<h1 class="contact-title fade-up">Hey, hi, and hello!</h1>

		<p class="contact-lead fade-up fade-up-delay-1">I love hearing from readers! You can use this form to reach out to me with any questions, comments, or concerns.</p>

		<div class="contact-form-panel fade-up fade-up-delay-2">
			<iframe data-tally-src="https://tally.so/embed/ja5GBQ?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&formEventsForwarding=1" loading="lazy" width="100%" height="342" frameborder="0" marginheight="0" marginwidth="0" title="Send a message"></iframe>
		</div>
	</div>
</Layout>

<style>
	.contact-page {
		padding-top: 1.5rem;
	}

	.contact-title {
		margin-top: 1rem;
	}

	.contact-lead {
		max-width: 36rem;
		color: var(--text-muted);
		font-size: 1.05rem;
	}

	.contact-form-panel {
		margin-top: 1.5rem;
		padding: 1.5rem;
		/* Kept light in both themes because the embedded Tally form uses dark text */
		background: #fdfcfb;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}
</style>

<script is:inline>//@ts-nocheck
	var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
</script>
