---
import Layout from "../layouts/BaseLayout.astro";
import { marked } from "marked";
import {getYamlToJsonData} from "../utils/helper";

const resourcesData = getYamlToJsonData("./src/data/resourcesData.yaml");
---

<Layout
	title="Links"
	description="A curated collection of useful links and resources"
	isMainLarge={true}
>
	<div class="resources-list">
		{
			resourcesData.resources.map((resource) => (
				<div class="group">
					<div class="card-header">
						<h2 class="card-header-title">{resource.category}</h2>
						<div class="card-header-description">
							{resource.description}
						</div>
					</div>
					<div class="card-items">
						{resource.links.map((link) => (
							<div class="card-item">
								<h3 class="card-item-name">
									<a href={link.url} target="_blank">
										{link.name}
									</a>
								</h3>
								<div
									class="card-item-details"
									set:html={marked(link.description)}
								/>
							</div>
						))}
					</div>
				</div>
			))
		}
	</div>
</Layout>

<style>
	.resources-list {
		width: 100%;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem;
		padding: 1.5rem 0;
	}

	.group {
		width: 100%;
		min-height: 100px;
		line-height: 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--bg-elevated);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		transition: border-color var(--transition-med), box-shadow var(--transition-med);
	}

	.group:hover {
		border-color: var(--brand-glow);
		box-shadow: var(--shadow-md);
	}

	:global([data-theme="dark"]) .group {
		background:
			linear-gradient(180deg, rgba(255, 244, 236, 0.07), transparent 32%),
			var(--bg-elevated);
		border-color: rgba(255, 236, 220, 0.1);
		box-shadow:
			inset 0 1px 0 rgba(255, 236, 220, 0.16),
			var(--shadow-sm);
	}

	:global([data-theme="dark"]) .group:hover {
		border-color: rgba(232, 122, 108, 0.55);
		box-shadow:
			inset 0 1px 0 rgba(255, 236, 220, 0.2),
			0 12px 32px -12px rgba(232, 122, 108, 0.45);
	}

	.card-header {
		width: 100%;
		padding: 1.25rem 1.5rem 1.1rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
		background:
			linear-gradient(160deg, rgba(255, 255, 255, 0.45), transparent 52%),
			linear-gradient(135deg, #f8d4cd 0%, #f3b7ac 55%, #eea497 100%);
	}

	:global([data-theme="dark"]) .card-header {
		border-bottom-color: rgba(255, 236, 220, 0.08);
		background:
			linear-gradient(160deg, rgba(255, 236, 220, 0.1), transparent 48%),
			linear-gradient(135deg, #3a2824 0%, #241816 100%);
	}

	.card-header-title {
		margin: 0 0 0.35rem;
		font-size: 1.3rem;
		font-weight: 600;
		font-family: var(--font-display);
		color: #4a2420;
	}

	:global([data-theme="dark"]) .card-header-title {
		color: #f4f1ee;
	}

	.card-header-description {
		color: rgba(74, 36, 32, 0.78);
		font-size: 0.95rem;
	}

	:global([data-theme="dark"]) .card-header-description {
		color: rgba(244, 241, 238, 0.68);
	}

	.card-items {
		padding: 0.25rem 1.5rem 1rem;
		color: var(--text-muted);
	}

	.card-item {
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.65rem;
	}

	.card-item:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.card-item-name {
		font-size: 1.05rem;
		margin: 0.85rem 0 0.25rem;
	}

	.card-item-name a {
		text-decoration: none;
		color: var(--text);
	}

	.card-item-name a:hover {
		color: var(--brand);
	}

	.card-item-details {
		font-size: 0.95rem;
	}

	.card-item-details :global(p) {
		margin-bottom: 0.35rem;
	}

	@media screen and (min-width: 900px) {
		.group {
			width: 375px;
		}
	}
</style>

<script>
	document.querySelectorAll('.card-item-details a').forEach(anchor => anchor.setAttribute("target", "_blank"))
</script>
