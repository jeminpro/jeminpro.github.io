---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../../consts";
import SocialLinks from "./SocialLinks.astro";
import { Icon } from 'astro-icon/components'

const menuItems = [
	{
		name: "Articles",
		path: "/articles",
	},
	{
		name: "Snippets",
		path: "/snippets",
	},
	{
		name: "Links",
		path: "/links",
	},
	{
		name: "Contact",
		path: "/contact",
	},
];
---

<header class="site-header">
	<nav class="nav-main">
		<a href="/" class="site-logo" title="home">
			<img class="logo-image" src="/images/JPLogo.svg" alt={SITE_TITLE} />
		</a>
		<div class="nav-links-desktop">
			{
				menuItems.map((menuItem) => (
					<HeaderLink href={menuItem.path}>{menuItem.name}</HeaderLink>
				))
			}
		</div>

		<button class="search-open" type="button" data-search-open aria-label="Search" aria-expanded="false" aria-controls="site-search">
			<Icon name="fa6-solid:magnifying-glass" />
		</button>

		<SocialLinks className="social-desktop" />

		<button class="mobile-burger-button" type="button"><Icon name="fa6-solid:bars" /></button>
	</nav>
	<nav class="nav-mobile d-none">
		{
			menuItems.map((menuItem) => (
			<HeaderLink href={menuItem.path} class="mobile-menu-item">{menuItem.name}</HeaderLink>
			))
		}
		<SocialLinks className="social-mobile" />
	</nav>

	<div id="site-search" class="search-overlay" data-site-search hidden role="dialog" aria-modal="true" aria-label="Search">
		<div class="search-sheet">
			<div class="search-field">
				<Icon name="fa6-solid:magnifying-glass" />
				<input type="search" placeholder="Search articles and snippets" aria-label="Search articles and snippets" autocomplete="off" />
				<button class="search-close" type="button" data-search-close aria-label="Close search">
					<kbd>Esc</kbd>
					<Icon name="fa6-solid:xmark" />
				</button>
			</div>
			<p class="search-hint" data-search-hint>Search by title or heading.</p>
			<div class="search-results" data-search-results hidden></div>
		</div>
	</div>
</header>

<style>
	.site-header {
		font-family: "Dosis", sans-serif;
		position: relative;
		background-image: url(/images/grain.png);
		background-color: #d35244;
	}

	.nav-main {
		display: flex;
		align-items: center;
		justify-content: space-between;
		position: relative;
		height: 8rem;
		margin: 0 auto;
		max-width: 100ch;
		box-shadow: 0 2px 2px -2px rgba(0, 0, 0, 0.4);
	}

	a {
		text-decoration: none;
		color: #fff;
		padding: 0.25em .75em;
	}

	a.override-color{
		color: black;
		text-decoration: underline;
	}

	.selected-menu-item {
		background: rgba(0, 0, 0, 0.1);
		border-radius: 5px;
		display: inline-block;
	}

	.site-logo {
		display: flex;
		align-items: center;
		padding: 1rem 2rem;
	}

	.logo-image {
		height: 4.25rem;
		padding: 0.3rem;
		border-radius: 20px;
		box-sizing: content-box;
		box-shadow: 0 12px 10px -10px #000000;
		background-color: #ffffff;
	}

	.mobile-burger-button {
		background-color: transparent;
		background-image: none;
		cursor: pointer;
		color: rgb(230, 230, 230);
		border: 0;
		margin-right: 20px;
	}

	[data-icon="fa6-solid:bars"] {
		font-size: 2rem;
	}

	.mobile-burger-button:hover {
		color: #fff;
	}

	.mobile-menu-item {
		display: block;
		padding: 1.5rem;
		border-bottom: 1px solid rgb(229, 231, 235);
		border-radius: 0px;
		font-size: 1.25rem;
	}

	.nav-links-desktop {
		display: none;
	}

	.search-open {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-left: auto;
		margin-right: 0.25rem;
		padding: 0.4rem;
		border: 0;
		background: transparent;
		color: rgb(230, 230, 230);
		cursor: pointer;
	}

	.search-open:hover,
	.search-open:focus-visible {
		color: #fff;
	}

	.search-open [data-icon] {
		font-size: 1.45rem;
	}

	:global(body.search-locked) {
		overflow: hidden;
	}

	.search-overlay {
		position: fixed;
		inset: 0;
		z-index: 40;
		overflow: auto;
		background: #f6f7f9;
		color: var(--gray-dark);
		font-family: "Inter", sans-serif;
		text-align: left;
	}

	.search-overlay[hidden] {
		display: none;
	}

	.search-sheet {
		width: min(46rem, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1.5rem 0 3rem;
	}

	.search-field {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.35rem 0 0.85rem;
		border-bottom: 1px solid rgba(31, 35, 40, 0.12);
	}

	.search-field [data-icon="fa6-solid:magnifying-glass"] {
		flex: none;
		font-size: 1.15rem;
		color: var(--gray);
	}

	.search-field input {
		flex: 1;
		min-width: 0;
		border: 0;
		padding: 0.35rem 0;
		background: transparent;
		color: var(--gray-dark);
		font: inherit;
		font-size: 1.45rem;
		line-height: 1.3;
		outline: none;
	}

	.search-field input::placeholder {
		color: var(--gray-medium);
	}

	.search-close {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex: none;
		border: 0;
		background: transparent;
		color: var(--gray);
		cursor: pointer;
		padding: 0.25rem;
	}

	.search-close kbd {
		display: none;
		border: 1px solid rgba(31, 35, 40, 0.16);
		border-radius: 6px;
		padding: 0.15rem 0.4rem;
		font-family: inherit;
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--gray);
	}

	.search-close [data-icon] {
		font-size: 1.25rem;
	}

	.search-close:hover,
	.search-close:focus-visible {
		color: var(--gray-dark);
	}

	.search-hint {
		margin: 1.25rem 0 0;
		color: var(--gray);
		font-size: 0.95rem;
	}

	.search-hint[hidden] {
		display: none;
	}

	.search-results {
		margin-top: 0.75rem;
	}

	.search-results[hidden] {
		display: none;
	}

	.search-results :global(.search-group) {
		padding: 0.85rem 0;
		border-bottom: 1px solid rgba(31, 35, 40, 0.08);
	}

	.search-results :global(.search-group:last-child) {
		border-bottom: 0;
	}

	.search-results :global(.search-type) {
		display: inline-block;
		margin: 0 0 0.35rem;
		padding: 0.12rem 0.5rem;
		border-radius: 999px;
		background: rgba(211, 82, 68, 0.12);
		color: #d35244;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.search-results :global(.search-page) {
		display: block;
		padding: 0.2rem 0.15rem;
		font-weight: 600;
	}

	.search-results :global(a) {
		display: block;
		border-radius: 8px;
		padding: 0.35rem 0.45rem;
		color: var(--gray-dark);
		text-decoration: none;
	}

	.search-results :global(a:hover),
	.search-results :global(a:focus-visible) {
		background: rgba(31, 35, 40, 0.06);
	}

	.search-results :global(.search-headings) {
		list-style: none;
		margin: 0.15rem 0 0;
		padding: 0;
	}

	.search-results :global(.search-headings a) {
		padding-left: 0.9rem;
		color: var(--gray);
		font-size: 0.98rem;
	}

	.search-results :global(.search-empty) {
		margin: 1rem 0 0;
		color: var(--gray);
	}

	@media (min-width: 750px) {
		.mobile-burger-button {
			display: none;
		}

		.nav-mobile {
			display: none;
		}

		.nav-links-desktop {
			display: flex;
			justify-content: center;
			align-items: center;
			flex-grow: 1;
			align-items: center;
			gap: 2rem;
			font-size: 1.25rem;
		}

		.search-open {
			margin-left: 0;
		}

		.search-sheet {
			padding-top: 12vh;
		}

		.search-close kbd {
			display: inline-block;
		}

		.nav-links-desktop a:not(.selected-menu-item) {
			position: relative;
			transition: opacity 150ms ease-in-out;
		}

		.nav-links-desktop a::after {
			content: "";
			display: block;
			height: 2px;
			background: #fff;
			position: absolute;
			left: 0;
			right: 0;
			bottom: -0.1em;
			transform: scale(0);
			transform-origin: left bottom;
			transition: transform 1s;
		}

		.nav-links-desktop a:not(.selected-menu-item):hover::after {
			transform: scale(1);
		}
	}
</style>
