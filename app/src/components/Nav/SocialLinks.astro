---
import { Icon } from 'astro-icon/components'

const {className} = Astro.props;

---

<div class={className}>
	<a target="_blank" href="https://www.linkedin.com/in/jeminpro/" aria-label="Likedin" class="social">
		<Icon name="linkedin" />
	</a>
	<a target="_blank" href="https://github.com/jeminpro" aria-label="Github" class="social">
		<Icon name="github" />
	</a>
	<a target="_blank" href="https://codepen.io/jemin" aria-label="Codepen" class="social">
		<Icon name="codepen" />
	</a>
</div>

<style>
	a {
		text-decoration: none;
		color: var(--text-muted);
		transition: color var(--transition-fast);
	}

	a:hover,
	a:focus-visible {
		color: var(--brand);
	}

	[data-icon] {
		font-size: 1.6rem;
	}

	.social-mobile {
		display: flex;
		gap: 1.25rem;
		padding: 1.25rem 1.5rem;
	}

	.social-footer {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		padding: 0.15rem 0 0.85rem;
	}
</style>