---
import { Icon } from 'astro-icon/components'

const {className} = Astro.props;

---

<div class={className}>
	<a target="_blank" href="https://www.linkedin.com/in/jeminpro/" aria-label="Likedin" class="social">
		<Icon name="linkedin" />
	</a>
	<a target="_blank" href="https://github.com/jeminpro" aria-label="Github" class="social">
		<Icon name="github" />
	</a>
	<a target="_blank" href="https://codepen.io/jemin" aria-label="Codepen" class="social">
		<Icon name="codepen" />
	</a>
</div>

<style>
	a {
		text-decoration: none;
		color: #fff;
	}

	[data-icon] {
		font-size: 2rem;
	}

	.social-mobile {
		display: flex;
		gap: 1rem;
		padding: 1.5rem;
	}

	.social-footer {
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		padding: 0.15rem 0 0.85rem;
	}

	.social-footer a {
		color: var(--gray-dark);
	}

	.social-footer a:hover,
	.social-footer a:focus-visible {
		color: var(--accent);
	}

</style>