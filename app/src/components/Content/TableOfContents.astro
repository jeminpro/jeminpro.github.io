---
import TocList from "./TocList.astro";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface TocItem extends Heading {
	children: TocItem[];
}

interface Props {
	headings: Heading[];
	contentHtml?: string;
	variant?: "inline" | "side";
}

const { headings, contentHtml = "", variant = "inline" } = Astro.props;

function excludedHeadingIds(html: string) {
	const excluded = new Set<string>();
	const tags = html.matchAll(/<\/?(details|dialog|h[1-6])\b[^>]*>/gi);
	let depth = 0;

	for (const match of tags) {
		const raw = match[0];
		const name = match[1].toLowerCase();
		const closing = raw[1] === "/";

		if (name === "details" || name === "dialog") {
			if (closing) depth = Math.max(0, depth - 1);
			else if (!raw.endsWith("/>")) depth += 1;
			continue;
		}

		if (closing || depth === 0) continue;
		const id = raw.match(/\sid=(?:"([^"]+)"|'([^']+)')/i);
		const value = id?.[1] ?? id?.[2];
		if (value) excluded.add(value);
	}

	return excluded;
}

const hiddenIds = excludedHeadingIds(contentHtml);

function selectHeadings(allHeadings: Heading[]) {
	const usable = allHeadings.filter((heading) => heading.slug && !hiddenIds.has(heading.slug) && heading.depth >= 1 && heading.depth <= 3);
	const hasSectionHeading = usable.some((heading) => heading.depth === 2);
	const selected = hasSectionHeading ? usable.filter((heading) => heading.depth >= 2) : usable;
	return selected.length >= 2 ? selected : [];
}

function buildToc(selected: Heading[]) {
	const items: TocItem[] = [];
	const stack: TocItem[] = [];

	for (const heading of selected) {
		const item: TocItem = { ...heading, children: [] };
		while (stack.length > 0 && stack[stack.length - 1].depth >= item.depth) {
			stack.pop();
		}

		const parent = stack[stack.length - 1];
		if (parent) parent.children.push(item);
		else items.push(item);
		stack.push(item);
	}

	return items;
}

const items = buildToc(selectHeadings(headings));
---

{
	items.length > 0 && variant === "inline" && (
		<nav class="toc toc-inline" aria-label="Table of contents">
			<details>
				<summary>On this page</summary>
				<TocList items={items} />
			</details>
		</nav>
	)
}

{
	items.length > 0 && variant === "side" && (
		<nav class="toc toc-side" aria-label="Table of contents">
			<p class="toc-label">On this page</p>
			<TocList items={items} />
		</nav>
	)
}
