---
import SocialLinks from "./Nav/SocialLinks.astro";
---

<footer>
	<SocialLinks className="social-footer" />
	<div class="typing-container">Designed by Jemin the <span typing-speed="70" typing-delay="1000" data-words="Front-end developer,Back-end developer,Full stack developer"></span></div>
</footer>
<style>
	footer {
		padding: 2rem 1rem 2.25rem;
		border-top: 1px solid var(--border);
		background: var(--bg-subtle);
		color: var(--text-muted);
		text-align: center;
		margin-top: auto;
		user-select: none;
	}

	:global([data-theme="dark"]) footer {
		background: linear-gradient(180deg, transparent, rgba(232, 122, 108, 0.06));
		border-top-color: rgba(232, 122, 108, 0.28);
	}

	.typing-container {
		font-size: 1.05rem;
		font-weight: 400;
		font-family: var(--font-display);
	}

	.typing-container span {
		color: var(--brand);
		font-weight: 600;
	}

	.typing-container span::after {
		content: '|';
		animation-name: blinking;
		animation-duration: .71s;
		animation-iteration-count: infinite;
	}

	@keyframes blinking {
		from {
			color: transparent;
		}

		to {
			color: var(--text-faint);
		}
	}
</style>
